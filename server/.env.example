# Salin berkas ini menjadi server/.env lalu isi nilainya. JANGAN commit atau bagikan server/.env.
# Kunci sandbox Midtrans: dashboard.sandbox.midtrans.com > Settings > Access Keys.
MIDTRANS_SERVER_KEY=SB-Mid-server-ISI_DI_SINI
ADMIN_TOKEN=ganti-dengan-teks-acak-panjang
ALLOWED_ORIGIN=http://localhost:8791
PORT=8793

# Uji alur bayar tanpa akun Midtrans dan tanpa uang: aktifkan mode simulasi (halaman bayar-simulasi.html). JANGAN dipakai di produksi.
# PAYMENT_MODE=simulasi
# Batasi metode Midtrans (opsional; kosong = ikut dashboard): nilai enabled_payments Midtrans dipisah koma
# PAYMENT_METHODS=
